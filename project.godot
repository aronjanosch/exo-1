; Renderer baseline. Scenes and gameplay are developed on spike branches.
config_version=5

[application]

config/features=PackedStringArray("4.7", "Forward Plus")

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
rendering_device/driver="vulkan"
rendering_device/driver.linuxbsd="vulkan"
rendering_device/driver.windows="vulkan"
rendering_device/driver.macos="vulkan"
